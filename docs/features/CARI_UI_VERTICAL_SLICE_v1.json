      "ownerMayChangeWithoutReopeningCARI_UI_001": "Issue-94 may revise these values before its contract is accepted"
    },
    "querySemantics": {
      "qFields": [
        "code",
        "legalName",
        "tradeName"
      ],
      "normalization": [
        "outer Unicode whitespace trim",
        "Unicode NFC"
      ],
      "turkishCaseAndAccent": "case-insensitive with Turkish I/İ/ı/i rules; accent-sensitive; exact SQL behavior is an acceptance gate",
      "roles": "repeatable Customer/Supplier/Tolling/Service with any/all on one context-eligible account",
      "partyState": [
        "active",
        "inactive",
        "all"
      ],
      "accountState": [
        "active",
        "inactive",
        "all"
      ],
      "sort": [
        "code",
        "legalName",
        "updatedAt"
      ],
      "direction": [
        "asc",
        "desc"
      ],
      "includeCount": "optional distinct visible Party count after authorization/context/filtering"
    },
    "responseMinimum": [
      "items",
      "nextCursor",
      "hasMore"
    ],
    "optionalCountFields": [
      "totalCount",
      "countScope"
    ]
  },
