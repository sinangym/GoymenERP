    "status": "OPEN_PROVISIONAL_LIMITS",
    "bindingSemantics": [
      "server-side bounded paging, filtering and deterministic unique tie-breaker",
      "single-company X-Company-Id mode and explicit server-resolved authorized-multi-company-read mode",
      "browser fan-out and client-side company union forbidden",
      "cursor opaque, authenticated and bound to actor/session/context/query/sort/contract revision",
      "tampered, malformed, expired or scope-mismatched cursor is fail-closed and returns no partial data",
      "Turkish search must be explicitly tested on real SQL before acceptance",
      "includeCount never exposes unauthorized or unfiltered group totals"
    ],
    "provisionalDefaults": {
      "decisionStatus": "OPEN; values are implementation candidates, not binding product decisions",
      "qMaximumLength": 200,
      "listPageSizeDefault": 50,
      "listPageSizeMaximum": 200,
      "invalidOrExpiredCursorCandidate": {
        "status": 400,
        "code": "invalid_cursor"
