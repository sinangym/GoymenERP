{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinangym/GoymenERP/docs/knowledge/schema/source-manifest-v1.schema.json",
  "title": "Göymen ERP knowledge source manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "provider",
    "source_id",
    "conversation_id",
    "conversation_title",
    "coverage",
    "inaccessible",
    "status",
    "privacy_review",
    "source_snapshot_sha256",
    "content_fingerprint_sha256",
    "files",
    "counts"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$" },
    "provider": { "enum": ["codex", "claude", "chatgpt"] },
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$" },
    "conversation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "conversation_title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "coverage": { "enum": ["complete", "visible_only", "partial"] },
    "inaccessible": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "enum": ["complete", "partial"] },
    "privacy_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_scan", "pii_review", "redactions"],
      "properties": {
        "secret_scan": { "const": "passed" },
        "pii_review": { "const": "passed" },
        "redactions": { "type": "integer", "minimum": 0 }
      }
    },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "content_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "attachments", "conflicts"],
      "properties": {
        "items": { "type": "integer", "minimum": 0 },
        "attachments": { "type": "integer", "minimum": 0 },
        "conflicts": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provider": { "const": "codex" } },
        "required": ["provider"]
      },
      "then": { "properties": { "source_id": { "pattern": "^codex-" } } }
    },
    {
      "if": {
        "properties": { "provider": { "const": "claude" } },
        "required": ["provider"]
      },
      "then": { "properties": { "source_id": { "pattern": "^claude-" } } }
    },
    {
      "if": {
        "properties": { "provider": { "const": "chatgpt" } },
        "required": ["provider"]
      },
      "then": { "properties": { "source_id": { "pattern": "^chatgpt-" } } }
    }
  ]
}
