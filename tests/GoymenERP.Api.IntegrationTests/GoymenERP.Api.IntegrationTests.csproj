<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../../tools/GoymenERP.CariAcceptance006/ProductSharedStateSnapshot.cs" Link="ProductAcceptance/ProductSharedStateSnapshot.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\e2e-fixtures\C01-E2E-GOLDEN-V1.json"
      LogicalName="GoymenERP.Api.IntegrationTests.Fixtures.C01-E2E-GOLDEN-V1.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\BuildingBlocks\GoymenERP.BuildingBlocks.SqlServer\GoymenERP.BuildingBlocks.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\backend\GoymenERP.Api\GoymenERP.Api.csproj" />
    <ProjectReference Include="..\..\src\backend\Modules\Accounting\GoymenERP.Modules.Accounting.Infrastructure\GoymenERP.Modules.Accounting.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\Modules\Finance\GoymenERP.Modules.Finance.Infrastructure\GoymenERP.Modules.Finance.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\Modules\Audit\GoymenERP.Modules.Audit.Infrastructure\GoymenERP.Modules.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\Modules\Counterparty\GoymenERP.Modules.Counterparty.Infrastructure\GoymenERP.Modules.Counterparty.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\Modules\Idempotency\GoymenERP.Modules.Idempotency.Infrastructure\GoymenERP.Modules.Idempotency.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\Modules\Inventory\GoymenERP.Modules.Inventory.Infrastructure\GoymenERP.Modules.Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\Modules\Organization\GoymenERP.Modules.Organization.Infrastructure\GoymenERP.Modules.Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\Modules\Manufacturing\GoymenERP.Modules.Manufacturing.Infrastructure\GoymenERP.Modules.Manufacturing.Infrastructure.csproj" />
    <ProjectReference Include="..\..\tools\GoymenERP.SqlServerRcsiReadiness\GoymenERP.SqlServerRcsiReadiness.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <RcsiToolProject>$(MSBuildProjectDirectory)\..\..\tools\GoymenERP.SqlServerRcsiReadiness\GoymenERP.SqlServerRcsiReadiness.csproj</RcsiToolProject>
    <RcsiToolSelfContainedPublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\rcsi-tool-self-contained\$(NETCoreSdkRuntimeIdentifier)\</RcsiToolSelfContainedPublishDir>
  </PropertyGroup>

  <Target
    Name="PublishSelfContainedSqlServerRcsiReadinessTool"
    AfterTargets="Build"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <RemoveDir Directories="$(RcsiToolSelfContainedPublishDir)" />
    <MSBuild
      Projects="$(RcsiToolProject)"
      Targets="Publish"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(NETCoreSdkRuntimeIdentifier);SelfContained=true;PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(RcsiToolSelfContainedPublishDir);NoRestore=true" />
  </Target>

</Project>
