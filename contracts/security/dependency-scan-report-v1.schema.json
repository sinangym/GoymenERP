{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "contracts/security/dependency-scan-report-v1.schema.json",
 "title": "Göymen ERP bağımlılık güvenlik taraması raporu v1",
 "description": "WP16 deterministik bağımlılık taramasının çıktı sözleşmesi; WP-C10 security.tech-watch.summary.v1 aracı bu dosyayı salt okunur okur (Ai:SecurityWatch:DependencyScanReportPath). Okuyucu katıdır: bilinmeyen anahtar, ekosistem veya önem derecesi, bozuk commit, eksik alan ya da 1 MiB üstü dosya raporu tümden geçersiz kılar ve hiçbir bulgu verilmez. Önem derecesi tarayıcının kendi etiketidir; eşik veya bayatlık hükmü üretilmez.",
 "type": "object",
 "additionalProperties": false,
 "required": ["format", "generatedAtUtc", "sourceCommit", "scanners", "findings"],
 "properties": {
  "format": {"const": "goymen.security.dependency-scan-report.v1"},
  "generatedAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
  "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "scanners": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "version"],
    "properties": {
     "name": {"$ref": "#/$defs/text"},
     "version": {"$ref": "#/$defs/text"}
    }
   }
  },
  "findings": {
   "type": "array",
   "maxItems": 2000,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ecosystem", "package", "installedVersion", "fixedVersion", "advisoryId", "severity", "title"],
    "properties": {
     "ecosystem": {"enum": ["github-actions", "npm", "nuget", "pip"]},
     "package": {"$ref": "#/$defs/text"},
     "installedVersion": {"$ref": "#/$defs/text"},
     "fixedVersion": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
     "advisoryId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{2,79}$"},
     "severity": {"enum": ["low", "moderate", "high", "critical"]},
     "title": {"$ref": "#/$defs/text"}
    }
   }
  }
 },
 "$defs": {
  "text": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"}
 }
}
