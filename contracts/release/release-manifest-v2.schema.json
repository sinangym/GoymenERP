{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinangym/GoymenERP/contracts/release/release-manifest-v2.schema.json",
  "title": "Source-only release manifest v2, additive producer",
  "description": "Exact committed source identities only. Not source admission, capabilities, applied migrations, compatibility, an environment, restore, build or deployment evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestMode",
    "releaseId",
    "source",
    "components",
    "recoveryInventory",
    "configuration",
    "features",
    "compatibility",
    "evidence",
    "result",
    "deployable",
    "assertions",
    "frontendFeatures",
    "apiContract",
    "schemaHeads",
    "v2SourceInputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "goymenerp.release-manifest.v2"
    },
    "manifestMode": {
      "const": "SOURCE_ONLY"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^source:[0-9a-f]{40}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "cleanCheckout"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/sinangym/GoymenERP"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "cleanCheckout": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "sourceRoot",
          "sourceFileCount",
          "sourceSha256",
          "artifactStatus"
        ],
        "properties": {
          "id": {
            "enum": [
              "backend-api",
              "frontend-web"
            ]
          },
          "kind": {
            "enum": [
              "BACKEND_API",
              "FRONTEND_WEB"
            ]
          },
          "sourceRoot": {
            "enum": [
              "src/backend",
              "src/frontend/goymen-erp-web"
            ]
          },
          "sourceFileCount": {
            "type": "integer",
            "minimum": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifactStatus": {
            "const": "NOT_BUILT"
          }
        }
      }
    },
    "recoveryInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "inventoryMode",
        "inventorySha256",
        "counts",
        "sources"
      ],
      "properties": {
        "schemaVersion": {
          "const": "goymenerp.recovery-surface-inventory.v1"
        },
        "inventoryMode": {
          "const": "SOURCE_ONLY"
        },
        "inventorySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dbContexts",
            "migrations",
            "durableStores"
          ],
          "properties": {
            "dbContexts": {
              "type": "integer",
              "minimum": 1
            },
            "migrations": {
              "type": "integer",
              "minimum": 1
            },
            "durableStores": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "gitBlob",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
              },
              "gitBlob": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "backendKeys",
        "frontendKeys",
        "sourceFiles"
      ],
      "properties": {
        "classification": {
          "const": "KEY_NAMES_ONLY"
        },
        "backendKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "frontendKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^VITE_[A-Z][A-Z0-9_]*$"
          }
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "gitBlob",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
              },
              "gitBlob": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourcePath",
          "sourceFileCount",
          "sourceSha256",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^src/backend/Modules/[A-Z][A-Za-z0-9]*$"
          },
          "sourceFileCount": {
            "type": "integer",
            "minimum": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "const": "SOURCE_PRESENT"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binarySchema",
        "configuration",
        "rollback",
        "forwardFix"
      ],
      "properties": {
        "binarySchema": {
          "const": "UNVERIFIED"
        },
        "configuration": {
          "const": "UNVERIFIED"
        },
        "rollback": {
          "const": "UNVERIFIED"
        },
        "forwardFix": {
          "const": "REVIEW_REQUIRED"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationBuild",
        "frontendBuild",
        "tests",
        "realSql",
        "securityScan",
        "sbom",
        "provenance",
        "attestation",
        "restore",
        "uat"
      ],
      "properties": {
        "applicationBuild": {
          "const": "NOT_RUN"
        },
        "frontendBuild": {
          "const": "NOT_RUN"
        },
        "tests": {
          "const": "NOT_RUN"
        },
        "realSql": {
          "const": "NOT_RUN"
        },
        "securityScan": {
          "const": "NOT_RUN"
        },
        "sbom": {
          "const": "MISSING"
        },
        "provenance": {
          "const": "UNVERIFIED"
        },
        "attestation": {
          "const": "MISSING"
        },
        "restore": {
          "const": "NOT_RUN"
        },
        "uat": {
          "const": "NOT_RUN"
        }
      }
    },
    "result": {
      "const": "UNVERIFIED"
    },
    "deployable": {
      "type": "boolean",
      "const": false
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceOnly",
        "containsSecrets",
        "containsConfigurationValues",
        "selectsProvider",
        "buildsArtifacts",
        "publishesArtifacts",
        "writesRegistry",
        "signsOrAttests",
        "appliesMigrations",
        "performsBackupOrRestore",
        "mutatesInfrastructure",
        "mutatesData",
        "deploys",
        "promotes",
        "activatesEnvironment"
      ],
      "properties": {
        "sourceOnly": {
          "type": "boolean",
          "const": true
        },
        "containsSecrets": {
          "type": "boolean",
          "const": false
        },
        "containsConfigurationValues": {
          "type": "boolean",
          "const": false
        },
        "selectsProvider": {
          "type": "boolean",
          "const": false
        },
        "buildsArtifacts": {
          "type": "boolean",
          "const": false
        },
        "publishesArtifacts": {
          "type": "boolean",
          "const": false
        },
        "writesRegistry": {
          "type": "boolean",
          "const": false
        },
        "signsOrAttests": {
          "type": "boolean",
          "const": false
        },
        "appliesMigrations": {
          "type": "boolean",
          "const": false
        },
        "performsBackupOrRestore": {
          "type": "boolean",
          "const": false
        },
        "mutatesInfrastructure": {
          "type": "boolean",
          "const": false
        },
        "mutatesData": {
          "type": "boolean",
          "const": false
        },
        "deploys": {
          "type": "boolean",
          "const": false
        },
        "promotes": {
          "type": "boolean",
          "const": false
        },
        "activatesEnvironment": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "frontendFeatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "sourcePath",
          "sourceFileCount",
          "sourceSha256",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "kind": {
            "enum": [
              "MODULE",
              "SHELL",
              "DESIGN_SYSTEM"
            ]
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^src/frontend/goymen-erp-web/src/[a-z][A-Za-z0-9]*$"
          },
          "sourceFileCount": {
            "type": "integer",
            "minimum": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "const": "SOURCE_PRESENT"
          }
        }
      }
    },
    "apiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "gitBlob",
        "sha256",
        "openapiVersion",
        "documentVersion",
        "operationCount",
        "operationIdsSha256"
      ],
      "properties": {
        "path": {
          "const": "contracts/openapi/goymen-erp-v1.json"
        },
        "gitBlob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "openapiVersion": {
          "type": "string",
          "pattern": "^3\\.[0-9]+\\.[0-9]+$"
        },
        "documentVersion": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "operationCount": {
          "type": "integer",
          "minimum": 1
        },
        "operationIdsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "schemaHeads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dbContext",
          "migrationsDirectory",
          "migrationCount",
          "latestMigration"
        ],
        "properties": {
          "dbContext": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*DbContext$"
          },
          "migrationsDirectory": {
            "type": "string",
            "pattern": "^src/backend/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)+Migrations$"
          },
          "migrationCount": {
            "type": "integer",
            "minimum": 1
          },
          "latestMigration": {
            "type": "string",
            "pattern": "^[0-9]{14}_[A-Za-z0-9]+$"
          }
        }
      }
    },
    "v2SourceInputs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "gitBlob",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
          },
          "gitBlob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
