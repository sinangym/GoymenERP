{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinangym/GoymenERP/contracts/recovery/recovery-surface-inventory-v1.schema.json",
  "title": "Göymen ERP source-only recovery surface inventory v1",
  "description": "A deterministic source inventory. It is not restore evidence, a recovery command, or an environment activation record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryMode",
    "sourceCommit",
    "counts",
    "dbContexts",
    "migrations",
    "documents",
    "durableStores",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "goymenerp.recovery-surface-inventory.v1"
    },
    "inventoryMode": {
      "const": "SOURCE_ONLY"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dbContexts",
        "migrations",
        "durableStores"
      ],
      "properties": {
        "dbContexts": {
          "const": 18
        },
        "migrations": {
          "const": 91
        },
        "durableStores": {
          "const": 20
        }
      }
    },
    "dbContexts": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*DbContext$"
          },
          "path": {
            "type": "string",
            "pattern": "^src/backend/.+DbContext\\.cs$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 91,
      "maxItems": 91,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^src/backend/.+/Migrations/[0-9]{14}_[A-Za-z0-9]+\\.cs$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationKeys",
        "objectStoreAdapters",
        "objectKeyPattern",
        "pathClassifications",
        "sourceFiles"
      ],
      "properties": {
        "configurationKeys": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^Documents:[A-Za-z:]+$"
          }
        },
        "objectStoreAdapters": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*DocumentObjectStore$"
              },
              "path": {
                "type": "string",
                "pattern": "^src/backend/Modules/Documents/.+DocumentObjectStore\\.cs$"
              }
            }
          }
        },
        "objectKeyPattern": {
          "const": "^companies/[0-9a-f]{32}/sha256/[0-9a-f]{64}$"
        },
        "pathClassifications": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "configurationKey",
              "classification"
            ],
            "properties": {
              "configurationKey": {
                "type": "string",
                "pattern": "^Documents:[A-Za-z:]+$"
              },
              "classification": {
                "enum": [
                  "RECOVERY_SET_CONTENT",
                  "TRANSIENT_EXCLUDED"
                ]
              }
            }
          }
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "durableStores": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "module",
          "kind",
          "dbContext",
          "entityType",
          "schema",
          "table",
          "contracts",
          "sourceFiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$"
          },
          "module": {
            "enum": [
              "Accounting",
              "Documents",
              "Finance",
              "Idempotency",
              "Inventory",
              "Logistics",
              "Manufacturing",
              "Product",
              "Purchasing",
              "Sales",
              "Work"
            ]
          },
          "kind": {
            "enum": [
              "delivery",
              "idempotency",
              "inbox",
              "outbox"
            ]
          },
          "dbContext": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*DbContext$"
          },
          "entityType": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "contracts": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*V1$"
            }
          },
          "sourceFiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^src/backend/.+\\.cs$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceOnly",
        "containsSecrets",
        "containsConfigurationValues",
        "selectsProvider",
        "performsBackupOrRestore",
        "mutatesInfrastructure",
        "mutatesData",
        "deploys"
      ],
      "properties": {
        "sourceOnly": {
          "const": true
        },
        "containsSecrets": {
          "const": false
        },
        "containsConfigurationValues": {
          "const": false
        },
        "selectsProvider": {
          "const": false
        },
        "performsBackupOrRestore": {
          "const": false
        },
        "mutatesInfrastructure": {
          "const": false
        },
        "mutatesData": {
          "const": false
        },
        "deploys": {
          "const": false
        }
      }
    }
  }
}
